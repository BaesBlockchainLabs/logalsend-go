# Copy to .env and fill in. The real .env is gitignored.
#
#     cp .env.example .env && chmod 600 .env
#
# Load into a shell with:
#     set -a; . ./.env; set +a
#
# The lgtsend command reads .env from the repository root on its own.

# --- Web service (WsDataChannel) --------------------------------------------
# Demo:       https://www.demo.logalty.es/lgt/lgtweb/wsDataChannel
# Production: ask Logalty.
LOGALTY_ENDPOINT=
LOGALTY_USER=
LOGALTY_PASSWORD=

# --- Sending company --------------------------------------------------------
# The company you send as, and the shipment type configured for it. Which
# Receiver fields are mandatory depends on the type.
LOGALTY_COMPANY=
LOGALTY_TYPE=

# --- Portal (web UI) --------------------------------------------------------
# Demo: https://www.demo.logalty.es/lgt/frontendweb
LOGALTY_PORTAL=

# --- SAML signing keystore --------------------------------------------------
# Only needed for the saml package. The certificate must be registered in the
# portal under #/administration/samlcertificates.
LOGALTY_PFX_PATH=
LOGALTY_PFX_PASSWORD=
